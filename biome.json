{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/coverage",
			"!!**/dist",
			"!!**/node_modules",
			"!!**/.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error"
			},
			"style": {
				"useConst": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["apps/api/src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/adapters/**",
											"@/application/**",
											"@/infrastructure/**",
											"@/composition/**",
											"@/modules/**",
											"@/persistence/**"
										],
										"message": "domain must not import outward (ARCHITECTURE.md dependency rule 1)"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/api/src/application/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/adapters/**",
											"@/composition/**",
											"@/modules/**",
											"@/persistence/**"
										],
										"message": "application must not import adapters or the composition root (ARCHITECTURE.md dependency rule 2)"
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
