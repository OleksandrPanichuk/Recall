{
	"name": "@recall/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"module": "src/entrypoints/telegram.ts",
	"scripts": {
		"build": "bun build ./src/entrypoints/telegram.ts ./src/entrypoints/mcp.ts ./src/entrypoints/mcp-http.ts ./src/entrypoints/admin.ts --outdir ../../dist --target bun",
