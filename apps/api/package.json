{
	"name": "@recall/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"module": "src/entrypoints/telegram.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"db:generate:pg": "drizzle-kit generate --config drizzle.postgres.config.ts",
		"db:migrate:pg": "drizzle-kit migrate --config drizzle.postgres.config.ts",
		"etl": "bun run ./scripts/migrate-to-postgres.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@nestjs/common": "^11",
		"@nestjs/core": "^11",
		"@nestjs/platform-express": "^11",
		"@nestjs/swagger": "^11",
		"@recall/contracts": "workspace:*",
		"@recall/kit": "workspace:*",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"express": "^5",
		"postgres": "^3.4.9",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"telegraf": "^4.16.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"drizzle-kit": "^0.31.10",
		"tsc-alias": "^1.8.16"
	}
}
