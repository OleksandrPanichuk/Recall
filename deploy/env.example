# Copy to the repo root as `.env.deploy` and fill it in. Every value below is
# read by `docker compose --env-file .env.deploy -f docker-compose.deploy.yml`.
# A key left out of this file is left unset in the container, which is what the
# apps expect for anything optional — an empty value is not the same as absent.

# ─── The public origin ────────────────────────────────────────────────────────

# The hostname of your ngrok endpoint, with no scheme and no trailing slash.
# Everything public is derived from it: BETTER_AUTH_URL, WEB_APP_URL, the ngrok
# --url flag. Use a reserved domain (ngrok gives one free static domain) — a
# random URL changes on every restart and invalidates the auth cookie origin,
# the MCP OAuth issuer and the Telegram webhook all at once.
PUBLIC_HOST=recall.ngrok.app

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Where nginx is published on the server itself. Loopback by default: ngrok is
# meant to be the only ingress, and a caller who reaches nginx directly can
# forge the X-Forwarded-* headers the apps trust. Set NGINX_BIND=0.0.0.0 only
# if you also want plain-HTTP LAN access — note that the session cookie is
# `secure`, so signing in over http:// will not work.
NGINX_BIND=127.0.0.1
NGINX_PORT=8080

# ─── Data ─────────────────────────────────────────────────────────────────────

POSTGRES_USER=recall
POSTGRES_PASSWORD=
POSTGRES_DB=recall

OBJECT_STORE_ACCESS_KEY=recall
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=recall-uploads

# ─── Identity ─────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
# Without it the api serves no /api/auth/* at all and nobody can sign in.
BETTER_AUTH_SECRET=

# Shared secret for the api's internal /bot/* RPC surface. The api and the bot
# must be given the same value. Generate with: openssl rand -hex 32
BOT_API_TOKEN=

# Numeric Telegram user id allowed to use this bot (ask @userinfobot). The api
# refuses any /bot/* body naming a different id, so both apps need it.
ALLOWED_TELEGRAM_USER_ID=

# IANA time zone used for streaks and spaced-repetition scheduling.
APP_TIMEZONE=Europe/Kyiv

# Registration is open by design; these two are what hold the line.
AUTH_RATE_LIMIT=on
# SIGN_UPS_PER_HOUR=10

# ─── Telegram ─────────────────────────────────────────────────────────────────

TELEGRAM_BOT_KEY=

# Leave both out to long-poll. Set both to have Telegram push updates instead —
# the path must start with /telegram/, which is what nginx routes to the bot.
# Generate the secret with: openssl rand -hex 32
# TELEGRAM_WEBHOOK_URL=https://recall.ngrok.app/telegram/replace-with-random-path
# TELEGRAM_WEBHOOK_SECRET=

# ─── Mail ─────────────────────────────────────────────────────────────────────

# Password reset mail. Point this at Mailpit to read it at
# http://127.0.0.1:55026, or at a real provider. Leave it out and the api only
# logs the letter — the reset link is then in `docker compose logs api`.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Recall <no-reply@recall.local>

# ─── MCP ──────────────────────────────────────────────────────────────────────

# /mcp exists only when this is set. Whoever holds it can write to your sets.
# Generate with: openssl rand -hex 32
MCP_HTTP_TOKEN=

# Turns on DNS-rebinding protection by allowlisting the Host header. It must
# list every host /mcp is reached as: the public one, and api:8767 for the
# stdio bridge container. Leave the key out to keep the protection off.
# MCP_HTTP_ALLOWED_HOST=recall.ngrok.app,api:8767

# OAuth, needed only by claude.ai and ChatGPT — they cannot carry a static
# token. Set both or neither, and make the issuer exactly https://$PUBLIC_HOST.
# MCP_OAUTH_ISSUER=https://recall.ngrok.app
# MCP_OAUTH_PASSPHRASE=at-least-sixteen-characters

# ─── Optional extras ──────────────────────────────────────────────────────────

# Mounts the react-admin REST surface at /api/*. The web app covers the same
# data with a real session, so leave this out unless you want the second door.
# ADMIN_PASSPHRASE=at-least-sixteen-characters

# How long a Telegram login link stays valid.
# AUTH_LINK_TTL_SECONDS=300

# Raises the stdio bridge's per-call timeout. nginx allows /mcp 180s.
# RECALL_MCP_TIMEOUT_MS=120000
