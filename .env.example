# Telegram bot token from @BotFather. Keep the real value out of Git.
TELEGRAM_BOT_KEY=123456789:replace-with-your-own-bot-token

# Numeric Telegram user id allowed to use this personal bot (ask @userinfobot).
ALLOWED_TELEGRAM_USER_ID=000000000

# Postgres connection string for the quiz data. `bun run db:up` starts the
# local Docker instance this default points at.
DATABASE_URL=postgres://recall:recall@127.0.0.1:55432/recall

# Path to the SQLite file holding MCP OAuth client credentials. Quiz data lives
# in Postgres; this is the only file left, and Better Auth replaces it.
OAUTH_DATABASE_PATH=./data/oauth.sqlite

# IANA time zone used for streaks and spaced-repetition scheduling.
APP_TIMEZONE=Europe/Kyiv

# Remote MCP over HTTP (only needed for `bun run mcp:http`).
# The token is the only gate: whoever holds it can write to your sets.
# Generate one with: openssl rand -hex 32
MCP_HTTP_TOKEN=replace-with-at-least-32-characters

# Interface to bind. Keep the loopback default and publish through a tunnel.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# Public hostname of the tunnel. Setting it turns on DNS-rebinding protection.
# Leave the key out entirely when there is no tunnel; an empty value is invalid.
# MCP_HTTP_ALLOWED_HOST=quiz.example.com

# OAuth, needed only by claude.ai and ChatGPT — they cannot carry a static token.
# Set both or neither. The issuer is the public https url the server answers on.
# MCP_OAUTH_ISSUER=https://quiz.example.com
# MCP_OAUTH_PASSPHRASE=at-least-sixteen-characters

# The admin web app. It falls back to MCP_OAUTH_PASSPHRASE when this is unset,
# and stays down when neither is set.
# ADMIN_PASSPHRASE=at-least-sixteen-characters
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8766

# The API. Every other app talks to it over HTTP; only it reaches the database.
API_HOST=127.0.0.1
API_PORT=8767

# The admin app runs on its own origin, so the API must be told to allow it.
ADMIN_ORIGIN=http://127.0.0.1:8766
API_URL=http://127.0.0.1:8767
