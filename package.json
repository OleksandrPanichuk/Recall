{
	"name": "op-personal-reminder-bot",
	"module": "src/entrypoints/telegram.ts",
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@types/bun": "latest",
		"drizzle-kit": "^0.31.10",
		"typescript": "^7.0.2"
	},
	"private": true,
	"scripts": {
		"build": "bun build ./src/entrypoints/telegram.ts ./src/entrypoints/mcp.ts ./src/entrypoints/mcp-http.ts --outdir ./dist --target bun",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"dev": "bun --watch ./src/entrypoints/telegram.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"migrate": "bun run ./scripts/migrate.ts",
		"start": "bun run ./dist/telegram.js",
		"test": "bun test",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"verify": "bun run check && bun run typecheck && bun test && bun run build",
		"mcp": "bun run ./src/entrypoints/mcp.ts",
		"backup": "bun run ./scripts/backup.ts",
		"restore": "bun run ./scripts/restore.ts",
		"status": "bun run ./src/entrypoints/telegram.ts --status",
		"seed": "bun run ./scripts/seed.ts",
		"mcp:http": "bun run ./src/entrypoints/mcp-http.ts"
	},
	"type": "module",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"drizzle-orm": "^0.45.2",
		"telegraf": "^4.16.3",
		"zod": "^4.4.3"
	}
}
