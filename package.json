{
	"name": "recall-quiz",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@types/bun": "latest",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"build": "bun run --filter '@recall/api' build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"verify": "bun run check && bun run typecheck && bun test && bun run build",
		"db:generate": "bun run --filter '@recall/api' db:generate",
		"migrate": "bun run ./scripts/migrate.ts",
		"backup": "bun run ./scripts/backup.ts",
		"restore": "bun run ./scripts/restore.ts",
		"seed": "bun run ./scripts/seed.ts",
		"up": "bun run ./scripts/up.ts",
		"dev": "bun --watch ./apps/api/src/entrypoints/telegram.ts",
		"start": "bun run ./dist/telegram.js",
		"status": "bun run ./apps/api/src/entrypoints/telegram.ts --status",
		"mcp": "bun run ./apps/api/src/entrypoints/mcp.ts",
		"mcp:http": "bun run ./apps/api/src/entrypoints/mcp-http.ts",
		"admin": "bun run ./apps/api/src/entrypoints/admin.ts"
	}
}
